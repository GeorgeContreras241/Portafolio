---
import Footer from "../components/Footer.astro";
import Nanvar from "../components/Nanvar.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { description, title } = Astro.props;
const canonicalURL = new URL(
  Astro.url.pathname,
  "https://porta-tau.vercel.app",
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XV814N8KRX"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XV814N8KRX");
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://porta-tau.vercel.app/og-image.png"
    />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="George Contreras - Portafolio" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://porta-tau.vercel.app/og-image.png"
    />

    <!-- Google -->
    <meta
      name="google-site-verification"
      content="l-alFNWuLelVJHLkOp7CcYWDs8A36mnNqOr_VM9mQSg"
    />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "George Contreras",
        url: "https://porta-tau.vercel.app",
        jobTitle: "Frontend Developer",
        description: description,
        sameAs: [
          "https://www.linkedin.com/in/georgecontreras241/",
          "https://github.com/GeorgeContreras241",
        ],
        knowsAbout: [
          "React",
          "Next.js",
          "JavaScript",
          "Tailwind CSS",
          "Astro",
          "Node.js",
          "MongoDB",
        ],
        alumniOf: {
          "@type": "EducationalOrganization",
          name: "Universidad de Cundinamarca",
        },
      })}
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-row text-white bg-editor-bg overflow-hidden">
    <Nanvar />
    <main class="w-full overflow-y-auto overflow-x-hidden mx-auto px-4 sm:px-8 md:px-12 lg:px-18 xl:px-28 2xl:px-32">
      <slot />
      <Footer />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    cursor: crosshair;
  }

  button,
  a {
    cursor: pointer;
  }
</style>
