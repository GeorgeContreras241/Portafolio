---
import User from "./icons/User.astro";
import Email from "./icons/Email.astro";
---

<section id="about" class="py-8 md:py-20 md:mb-20">
  <div class="mb-4 flex flex-col justify-center items-center text-center md:mb-14">
    <h2 class="text-xl md:text-5xl lg:text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-variable to-statusbar-bg mb-4 gsap-title">
        Sobre Mí
    </h2>
    <p class="text-text-default/80 text-sm md:text-xl max-w-2xl mx-auto gsap-subtitle">Formación, experiencia y lo que me mueve</p>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <div class="lg:w-1/4 flex flex-col items-center gap-2 about-avatar w-full">
      <div class="relative group">
        <div class="absolute -inset-2 bg-gradient-to-r from-object-global via-keyword to-boolean opacity-60 blur-lg group-hover:opacity-100 transition-opacity duration-500" style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);"></div>
        <div class="relative w-28 h-28 transition-transform duration-300 group-hover:scale-105" style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);">
          <div class="absolute inset-0 bg-gradient-to-br from-object-global via-keyword to-boolean"></div>
          <img
            src="/logo/Logo.webp"
            alt="George Contreras"
            class="relative z-10 w-full h-full object-cover p-[2px]"
            style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);"
            loading="lazy"
          />
        </div>
      </div>
      <div class="text-center">
        <h3 class="text-sm text-text-default font-semibold">George Contreras</h3>
        <p class="text-variable text-xs">Frontend Developer</p>
      </div>
    </div>

    <div class="lg:w-3/4 space-y-4 w-full">
      <p class="text-xs md:text-sm leading-relaxed text-text-default">
        <span class="text-variable font-medium">Tecnólogo en Desarrollo de Software</span> — Universidad de Cundinamarca (2024). Me enfoco en <span class="text-boolean">Frontend</span> construyendo interfaces con React y Next.js, pero con conocimientos sólidos en Backend (Node.js, Express, MongoDB) para desarrollo completo.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-1">
        <div class="bg-sidebar-bg/60 rounded-lg p-2.5 border border-white/5">
          <span class="text-boolean text-[10px] font-mono block mb-1">// Frontend</span>
          <p class="text-xs text-text-default font-medium">React, Next.js, Tailwind, Astro</p>
        </div>
        <div class="bg-sidebar-bg/60 rounded-lg p-2.5 border border-white/5">
          <span class="text-boolean text-[10px] font-mono block mb-1">// Backend</span>
          <p class="text-xs text-text-default font-medium">Node.js, Express, MongoDB</p>
        </div>
        <div class="bg-sidebar-bg/60 rounded-lg p-2.5 border border-white/5">
          <span class="text-boolean text-[10px] font-mono block mb-1">// Busco</span>
          <p class="text-xs text-text-default font-medium">Roles Frontend o Full Stack</p>
        </div>
        <div class="bg-sidebar-bg/60 rounded-lg p-2.5 border border-white/5">
          <span class="text-boolean text-[10px] font-mono block mb-1">// Disponibilidad</span>
          <p class="text-xs text-text-default font-medium">Full-time, remoto o híbrido</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 pt-2">
        <a
          href="#projects"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-gray-800/50 hover:bg-blue-600/10 text-blue-400 hover:text-blue-300 rounded-md text-[11px] font-medium transition-all duration-300 border border-gray-700/50 hover:border-blue-500/30"
        >
          Ver mis proyectos →
        </a>
        <a
          href="mailto:georgecontreras241@gmail.com"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-gray-800/50 hover:bg-green-600/10 text-green-400 hover:text-green-300 rounded-md text-[11px] font-medium transition-all duration-300 border border-gray-700/50 hover:border-green-500/30"
        >
          <Email class="w-3 h-3" />
          Contactar
        </a>
      </div>
    </div>
  </div>
</section>