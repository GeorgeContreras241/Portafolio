---
import certifications from "../const/certifications";
---

<div class="space-y-2">
  <h3 class="text-base font-bold text-white flex items-center gap-2 mb-3">
    <span class="bg-clip-text text-transparent bg-gradient-to-r from-variable to-statusbar-bg">
      Educación & Certificaciones
    </span>
  </h3>

  <ul class="flex flex-wrap gap-2">
    {
      certifications?.map((item) => (
        <li class="group flex items-center gap-3 px-4 py-3 rounded-lg bg-sidebar-bg/50 border border-white/5 hover:border-white/10 transition-all duration-200">
          <div class="w-10 h-10 p-1.5 bg-white/5 rounded-md flex items-center justify-center flex-shrink-0">
            <img
              src={item.image}
              alt={item.name}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-sm font-medium text-white leading-tight">{item.name}</span>
            <span class="text-xs text-gray-500">{item.date}</span>
          </div>
          {item.url && (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver certificado de ${item.name}`}
              class="ml-auto shrink-0 text-gray-500/60 hover:text-blue-400 transition-colors duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path
                  d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"
                />
              </svg>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
