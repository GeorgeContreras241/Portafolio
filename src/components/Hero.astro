---
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Link_A from "./ui/Link_A.astro";
import Code from "./icons/Code.astro";
import Email from "./icons/Email.astro";
import Skill_Object from "./ui/Skill_Object.astro";
import Hero_Contact from "./ui/Hero_Contact.astro";
---

<section
  id="hero"
  class="flex flex-col sm:flex-col md:flex-col lg:flex-col xl:flex-row place-items-center min-h-[calc(100vh-6rem)]"
>
  <div>
    <div>
      <div
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-sidebar-bg bg-sidebar-bg/50 font-mono text-sm w-fit"
      >
        <Code class="w-3 h-3" />
        <span class="text-gray-400">//</span>
        <span class="text-gray-500">Hola, soy George Contreras</span>
      </div>

      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mt-4"
      >
        Full Stack Developer
      </h1>

      <p class="mt-3 text-xl md:text-[.9rem] font-semibold">
        <span
          class="bg-clip-text text-transparent bg-gradient-to-r from-variable to-object-global"
        >
          MERN Stack
        </span>
      </p>

      <p class="text-lg md:text-[.95rem] text-text-default/80 leading-relaxed mt-4 w-[90%]">
        Construyo interfaces modernas, rápidas y responsivas con
        <span class="text-boolean">React</span>,
        <span class="text-boolean">Next.js</span> y
        <span class="text-boolean">Tailwind CSS</span>. Disponible para
        trabajar.
      </p>

      <div class="flex items-center gap-6 mt-8">
        <div>
          <span class="block text-2xl font-bold text-blue-700">3</span>
          <span
            class="block text-xs text-text-default/50 uppercase tracking-wider mt-1"
            >Proyectos</span
          >
        </div>
        <span class="w-px h-10 bg-sidebar-bg"></span>
        <div>
          <span class="block text-2xl font-bold text-blue-700">1</span>
          <span
            class="block text-xs text-text-default/50 uppercase tracking-wider mt-1"
            >Certificación</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col items-center gap-6">
    <Skill_Object />
    <Hero_Contact />
  </div>
</section>
