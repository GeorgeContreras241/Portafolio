---
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Link_A from "./ui/Link_A.astro";
import Code from "./icons/Code.astro";
import Email from "./icons/Email.astro";
import Skill_Object from "./ui/Skill_Object.astro";
import Hero_Contact from "./ui/Hero_Contact.astro";
import Arrow from "./icons/Arrow.astro";
---

<section
  id="hero"
  class="relative pb-10 lg:pb-0 grid grid-cols-1 items-center grid-rows-[1fr_1fr] lg:grid-rows-[auto] lg:grid-cols-[60fr_40fr] lg:items-center lg:gap-4 justify-center md:min-h-[100dvh]"
>
  <div class="flex flex-col gap-4 xl:gap-6 w-full h-auto">
    <div>
      <div
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-sidebar-bg bg-sidebar-bg/50 font-mono text-xs md:text-sm w-fit"
      >
        <Code class="w-3 h-3" />
        <span class="text-gray-400">//</span>
        <span class="text-gray-500">Hola, soy George Contreras</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mt-4"
      >
        Full Stack Developer
      </h1>

      <p class="mt-3 text-lg md:text-[.9rem] font-semibold">
        <span
          class="bg-clip-text text-transparent bg-gradient-to-r from-variable to-object-global"
        >
          MERN Stack
        </span>
      </p>

      <p
        class="text-base md:text-[.95rem] text-text-default/80 leading-relaxed mt-4 w-full sm:w-[90%]"
      >
        Construyo interfaces modernas, rápidas y responsivas con
        <span class="text-boolean">React</span>,
        <span class="text-boolean">Next.js</span> y
        <span class="text-boolean">Tailwind CSS</span>. Disponible para
        trabajar.
      </p>

      <div class="flex items-center gap-5 mt-6">
        <div>
          <span class="block text-xl md:text-2xl font-bold text-blue-700">3</span>
          <span
            class="block text-[10px] md:text-xs text-text-default/50 uppercase tracking-wider mt-1"
            >Proyectos</span
          >
        </div>
        <span class="w-px h-10 bg-sidebar-bg"></span>
        <div>
          <span class="block text-xl md:text-2xl font-bold text-blue-700">1</span>
          <span
            class="block text-[10px] md:text-xs text-text-default/50 uppercase tracking-wider mt-1"
            >Certificación</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col items-center gap-4 w-full max-w-lg mx-auto lg:max-w-none h-auto">
    <Skill_Object />
    <Hero_Contact />
  </div>

  <a
    href="#projects"
    aria-label="Ir a proyectos"
    class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 text-white/40 hover:text-white transition-colors duration-300"
  >
    <Arrow class="w-6 h-6 animate-bounce" />
  </a>
</section>
