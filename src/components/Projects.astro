---
import GitHub from "./icons/GitHub.astro";
import Web from "./icons/Web.astro";
import React from "./icons/React.astro";
import Tailwind from "./icons/Tailwind.astro";
import Code from "./icons/Code.astro";
import Astro_icons from "./icons/Astro_icon.astro";
import Express from "./icons/Express.astro";
import JavaScript from "./icons/JavaScript.astro";
import Mongo from "./icons/Mongo.astro";
import Next from "./icons/Next.js.astro";
import Node from "./icons/Node.astro";
import { projects } from "../const/projects.js";

const getComponentIcon = (name: any) => {
  const icons: any = {
    React,
    Next,
    Astro_icons,
    JavaScript,
    Tailwind,
    Node,
    Express,
    Mongo,
    GitHub,
  };

  return icons[name] || null;
};

const techFilters = [...new Set(projects.flatMap((p) => p.technologies.map((t) => t.name)))];
---

<section id="projects" class="py-10 md:py-16">
  <div class="mx-auto">
    <div class="mb-5">
      <h2 class="text-lg md:text-[30px] font-bold text-white flex items-center gap-1">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-variable to-statusbar-bg">
          Proyectos Destacados
        </span>
      </h2>
      <p class="mt-1 text-gray-400 text-sm">3 aplicaciones desplegadas en producción</p>
    </div>

    <div class="flex flex-wrap gap-2 mb-6" id="filter-bar">
      <button
        data-filter="all"
        class="filter-btn px-3 py-1 rounded-full text-xs font-medium border border-white/10 bg-sidebar-bg/60 text-white transition-all duration-200"
      >
        Todos
      </button>
      {
        techFilters.map((tech) => (
          <button
            data-filter={tech}
            class="filter-btn px-3 py-1 rounded-full text-xs font-medium border border-white/10 bg-sidebar-bg/60 text-white/70 transition-all duration-200"
          >
            {tech}
          </button>
        ))
      }
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        projects?.map((project) => (
          <article
            data-tech={project.technologies.map((t) => t.name).join(" ")}
            class="project-card group relative bg-sidebar-bg/80 rounded-xl border border-white/5 overflow-hidden transition-all duration-300 hover:border-white/15 flex flex-col"
          >
            <div class="relative overflow-hidden">
              <div class="bg-editor-bg p-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                <span class="text-xs text-gray-400 ml-2 truncate">{project.name}</span>
              </div>
              <div class="relative bg-gray-900 aspect-[16/7] overflow-hidden">
                <img
                  transition:name="image-project"
                  src={project.image}
                  alt={project.name}
                  loading="lazy"
                  decoding="async"
                  class="image w-full h-full object-cover"
                />
              </div>
            </div>

            <div class="p-4 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-1.5">
                <h3 class="text-[1rem] md:text-[1.1rem] font-bold text-white">{project.name}</h3>
                {project.state && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-900/30 text-green-300 border border-green-400/30 whitespace-nowrap">
                    Activo
                  </span>
                )}
              </div>
              <p class="text-gray-400 text-sm mb-1">{project.description}</p>
              {project.highlight && (
                <p class="text-variable text-xs font-mono mb-3">// {project.highlight}</p>
              )}
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.technologies.map((tech) => {
                  const Icon = getComponentIcon(tech.icon);
                  return (
                    <span class="inline-flex items-center gap-1 bg-gray-800/70 text-xs text-gray-300 px-2 py-1 rounded-md border border-gray-700/50">
                      {Icon && <Icon class="h-3 w-3 text-blue-400" />}
                      {tech.name}
                    </span>
                  );
                })}
              </div>
              <div class="flex flex-wrap gap-3 mt-auto">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-3 py-1.5 bg-gray-800/50 hover:bg-blue-600/10 text-blue-400 hover:text-blue-300 rounded-lg text-xs font-medium transition-all duration-300 border border-gray-700/50 hover:border-blue-500/30 group flex-1 text-center"
                  aria-label="Ver en GitHub"
                >
                  <GitHub class="h-4 w-4 group-hover:scale-110 transition-transform flex-shrink-0" />
                  <span>Código</span>
                </a>
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-3 py-1.5 bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 hover:text-blue-300 rounded-lg text-xs font-medium transition-all duration-300 border border-blue-500/20 hover:border-blue-400/30 group flex-1 text-center"
                    aria-label="Ver demo"
                  >
                    <Web class="h-4 w-4 group-hover:scale-110 transition-transform flex-shrink-0" />
                    <span>Demo</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("text-white", "bg-blue-600/20", "border-blue-500/30"));
      btn.classList.add("text-white", "bg-blue-600/20", "border-blue-500/30");

      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.tech.split(" ").includes(filter);
        card.style.display = show ? "" : "none";
      });
    });
  });
</script>